# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.

# --- Required ---

# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers. Remember to URL-encode special
# characters in the password, and include a database name (e.g. /osrspt).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/osrspt?retryWrites=true&w=majority

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME

# --- Optional ---

# Model used for chat completions.
OPENAI_MODEL=gpt-4o-mini

# development | production
NODE_ENV=development

# Local port. On Render this is supplied automatically — do not set it there.
PORT=3000

# Number of prior messages replayed into the model per request.
HISTORY_LIMIT=20

# Comma-separated allow-list of browser origins. Leave empty when the
# frontend is served from the same origin as the API (the default).
CORS_ORIGINS=
